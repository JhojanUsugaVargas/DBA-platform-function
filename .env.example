# ==============================================================================
# DataCheck - Example Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in your values. Never commit `.env` to git!

# --- Application ---
APP_NAME=DataCheck API
APP_VERSION=1.0.0
DEBUG=false

# --- Security & JWT ---
# Secret key used for signing JWT tokens. Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Fernet symmetric encryption key for remote database connection strings.
# Must be 32 url-safe base64-encoded bytes. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=u275j75GZ7XN9Lh3t_tL05iZz-5hO7pY-o28pZkU7_o=

# --- Primary Database (DataCheck Metadata & Users) ---
# Supported engines: PostgreSQL (pg8000 / psycopg2) or SQLite for local testing
DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/dba_platform_function
# SQLite alternative for zero-setup local development:
# DATABASE_URL=sqlite:///./datacheck.db
DB_SCHEMA=datacheck

# --- AI Integration (Gemini Assistant) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Two-Factor Authentication (OTP via Email) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
OTP_EXPIRE_SECONDS=120

# --- Default Admin Seed (Created automatically on initial database startup) ---
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=Admin123!

# --- CORS Allowed Origins ---
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8005,http://127.0.0.1:8005

# --- Privacy & Legal Compliance (Ley 1581 de 2012 / Habeas Data) ---
DATA_CONTROLLER_NAME=Equipo DBA - DataCheck Pro
PRIVACY_CONTACT_EMAIL=privacidad@datacheck.local
LEGAL_VERSION=2026-10-20
FRONTEND_URL=http://localhost:4200
PUBLIC_API_URL=http://localhost:8005
UNSUBSCRIBE_TOKEN_EXPIRE_DAYS=365
